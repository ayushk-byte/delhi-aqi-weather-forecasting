# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local infrastructure (Docker Compose supplies service-host defaults when blank)
DATABASE_URL=
REDIS_URL=
POSTGRES_PASSWORD=postgres

# Data Ingestion Settings
AQI_PROVIDER=openaq
WEATHER_PROVIDER=open_meteo

# OpenAQ v3 API Key (required; create at https://explore.openaq.org/)
OPENAQ_API_KEY=replace-with-your-openaq-v3-key

# Data.gov.in / CPCB API Key (Optional)
DATA_GOV_IN_API_KEY=

# Refresh cadence (OpenAQ latest endpoints are called per matched location)
WORKER_INTERVAL_MINUTES=15
WEATHER_REFRESH_MINUTES=15
AQI_REFRESH_MINUTES=15
DATA_FRESH_LIVE_MINUTES=15
DATA_FRESH_RECENT_MINUTES=60

# Set only when the API runs outside Docker and needs a non-default URL
API_BASE_URL=http://127.0.0.1:8000

# Local Storage Paths
DATA_DIR=data
MODELS_DIR=models
